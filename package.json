{
  "name": "abyss-player",
  "productName": "abyss",
  "version": "1.0.0",
  "description": "a tiny old-school music player for the YouTube Music era",
  "author": {
    "name": "Capri-cmd",
    "email": "348024877+Capri-cmd@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Capri-cmd/ABYSS-PLAYER.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5199 && cross-env ABYSS_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "vendor": "node scripts/vendor-python.mjs",
    "dist": "vite build && electron-builder --win nsis",
    "icon": "python scripts/make-icon.py && python scripts/make-skin-icon.py",
    "dist:linux": "vite build && electron-builder --linux AppImage deb pacman"
  },
  "build": {
    "appId": "app.abyss.player",
    "productName": "abyss",
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "electron/ytdlp_worker.py"
    ],
    "extraResources": [
      {
        "from": "vendor/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "icon": "assets/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "abyss-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "abyss",
      "uninstallDisplayName": "abyss",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Audio",
      "icon": "assets/icon.png",
      "executableName": "abyss",
      "synopsis": "a tiny old-school music player for youtube music",
      "description": "abyss is a small winamp-shaped player for YouTube Music: search, artist pages, synced lyrics, crossfade, skins and offline downloads.",
      "artifactName": "abyss-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "abyss",
          "Keywords": "music;player;youtube;winamp;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "util-linux-libs",
        "libsecret",
        "alsa-lib"
      ]
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@fontsource/vt323": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0"
  },
  "homepage": "https://github.com/Capri-cmd/ABYSS-PLAYER"
}
